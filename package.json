{
  "name": "pulpit-ai",
  "productName": "PulpitAI",
  "version": "0.1.0",
  "type": "module",
  "description": "Real-time Yoruba to English sermon translator for livestreams (OBS / vMix)",
  "main": "electron/main.js",
  "author": "Adeolu",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:debug": "node scripts/dev.mjs --devtools",
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.0.11"
  },
  "build": {
    "appId": "com.adex.pulpitai",
    "productName": "PulpitAI",
    "copyright": "Copyright (c) 2026 Adeolu Adex",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup-${arch}.exe"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.zip"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "maintainer": "Adeolu Adex <adeoluamole@gmail.com>",
      "category": "Utility",
      "synopsis": "Real-time Yoruba to English sermon translator"
    },
    "publish": {
      "provider": "github",
      "owner": "Ade-Adex",
      "repo": "PulpitAI"
    }
  }
}
